# Data files — too large / sensitive for version control
data/raw/*
data/data_experiments/*
data/corpora/*

# === JSON policy ===
# Ignore ALL json by default; only the raw model-generated answers (produced on the
# GPU box and synced PC<->box via git) are tracked. Everything else (annotations,
# samples, classification, etc.) is PC-side and regenerable.
*.json
!outputs/answers/vanilla_500/*
!outputs/answers/ansari_test_500/*
!data/islamiceval2026_RELEASE/*.json
# ...but never the held-out test material, which the line above would re-include.
data/islamiceval2026_RELEASE/ansari_test_500.json
data/islamiceval2026_RELEASE/_scorer_test_bases.json
data/islamiceval2026_RELEASE/test.jsonl
data/islamiceval2026_test_set/
outputs/answers/ansari_test_500/

# ignnore all .csv files
*.csv
*.tsv


# Derived / PC-side spreadsheets + plots (regenerable; not synced)
outputs/analysis/
outputs/answers/samples/*.xlsx

# Logs
logs/

# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# claude md files
CLAUDE.md
WORK_LOG.md

# PDF
*.pdf